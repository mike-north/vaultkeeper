# Pinned toolchain versions and size budget for the committed
# packages/vaultkeeper-wasm/wasm/*.wasm artifact.
#
# This is the single source of truth for BOTH:
#   - the "wasm-guards" CI job (.github/workflows/ci.yml), which rebuilds the
#     artifact with these exact versions and fails if it drifts from what's
#     committed, or if it breaches the size budget below.
#   - the local regeneration command documented in
#     packages/vaultkeeper-wasm/README.md, which must use the same versions
#     for its output to match what CI expects.
#
# When bumping any of RUST_TOOLCHAIN_VERSION / WASM_PACK_VERSION /
# BINARYEN_VERSION, regenerate the committed artifact (see the README) and
# commit it in the same change — the drift check will otherwise fail on the
# very next PR.
RUST_TOOLCHAIN_VERSION=1.95.0
WASM_PACK_VERSION=0.15.0
BINARYEN_VERSION=131

# sha256 of the exact release tarballs the CI job downloads
# (wasm-pack-v<ver>-x86_64-unknown-linux-musl.tar.gz and
# binaryen-version_<ver>-x86_64-linux.tar.gz). Recompute alongside any
# version bump above — the install steps hard-fail on a mismatch, so a
# replaced or tampered release asset cannot silently enter the build.
WASM_PACK_SHA256=c09f971ecaed9a2efc80fdcea7a00ef6b53c7fadc8c57d1f61b53a6aa66b668a
BINARYEN_SHA256=b5bf1f0eaf17c63ee588ff7a5954dc8f6ce2c26989051c66f24dfe9ece3e46db

# Budgets are intentionally generous starting points (issue #240). Bump here
# if a legitimate feature addition (e.g. the signing port) needs more space —
# this is the one place to change.
WASM_UNCOMPRESSED_BUDGET_BYTES=1048576
WASM_GZIP_BUDGET_BYTES=409600
