# Pinned toolchain versions for the committed
# crates/vaultkeeper-core/public-api.txt listing (docs/specs/001 §3.1).
#
# This is the single source of truth for BOTH:
#   - the "rust-public-api" CI job (.github/workflows/ci.yml), which
#     regenerates the listing with these exact versions and fails if it
#     drifts from what's committed.
#   - the local check/generate commands (scripts/rust-public-api.sh, wired
#     as `pnpm check:rust-api` / `pnpm generate:rust-api`), which must use
#     the same versions for their output to match what CI expects.
#
# `cargo public-api` builds rustdoc JSON, which requires the nightly
# `-Z unstable-options` rustdoc flags — hence the pinned nightly toolchain
# below (mirrors crates/vaultkeeper-wasm/wasm-toolchain.env's pinning of the
# wasm build toolchain: a floating nightly would make this gate flaky, so a
# nightly bump is a deliberate, reviewed event, not an incidental one).
#
# When bumping either version, regenerate the committed listing (see
# CLAUDE.md's "Rust public-API snapshot" section) and commit it in the same
# change — the drift check will otherwise fail on the very next PR.
RUST_API_NIGHTLY_TOOLCHAIN=nightly-2026-06-01
CARGO_PUBLIC_API_VERSION=0.52.0
