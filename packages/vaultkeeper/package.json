{
  "name": "vaultkeeper",
  "version": "0.8.0",
  "description": "Unified, policy-enforced secret storage across OS backends",
  "homepage": "https://github.com/mike-north/vaultkeeper#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mike-north/vaultkeeper.git",
    "directory": "packages/vaultkeeper"
  },
  "bugs": "https://github.com/mike-north/vaultkeeper/issues",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsup && node scripts/inject-node-types-reference.mjs",
    "clean": "node -e \"import('node:fs').then(fs=>fs.rmSync('dist',{recursive:true,force:true}))\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:typecheck": "tsc --noEmit",
    "check:lint-ts": "eslint .",
    "check:api-report": "api-extractor run",
    "check": "pnpm check:typecheck && pnpm check:lint-ts && pnpm check:api-report",
    "generate:api-report": "api-extractor run --local"
  },
  "keywords": [],
  "author": "Mike North <michael.l.north@gmail.com>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "jose": "^6.0.0"
  },
  "peerDependencies": {
    "@1password/sdk": "^0.4.0",
    "@types/node": ">=20"
  },
  "peerDependenciesMeta": {
    "@1password/sdk": {
      "optional": true
    },
    "@types/node": {
      "optional": true
    }
  },
  "devDependencies": {
    "@1password/sdk": "^0.4.0",
    "@microsoft/api-documenter": "^7.0.0",
    "@microsoft/api-extractor": "^7.57.2",
    "@types/node": "^22.0.0",
    "fixturify-project": "^7.1.3",
    "tsup": "^8.0.0"
  }
}
